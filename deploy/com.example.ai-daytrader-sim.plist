<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.ai-daytrader-sim</string>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/ai-daytrader-sim</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/TO/uv</string><string>run</string><string>daytrader-sim</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/ai-daytrader-sim.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/ai-daytrader-sim.err.log</string>
</dict></plist>
